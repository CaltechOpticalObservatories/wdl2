// ----------------------------------------------------------------------------
// @file     wdl2.lark
// @brief    native WDL 2.0 grammar (LALR(1))
// @author   David Hale
// ----------------------------------------------------------------------------
// Copyright (C) 2026 California Institute of Technology
// SPDX-License-Identifier: BSD-3-Clause
//
//     This program is part of the Waveform Definition Language (WDL) version 2.
//     Distributed under the terms of the BSD 3-Clause License; see pyproject.toml.
// ----------------------------------------------------------------------------
// Each rule notes the WDL1 construct it replaces and any edge case it carries.
// The language is grown one construct at a time. top_item gains the block forms
// (signals, slot, waveform, sequence, mode) as those constructs are added.

// ----------------------------------------------------------------------------
// top level
// ----------------------------------------------------------------------------
// Replaces the .conf orchestration: one source language, organised across files
// linked by `include` directives rather than a separate project manifest.
//
start: top_item*

?top_item: include_directive
         | const_decl
         | param_decl
         | signals_block
         | slot_block
         | waveform_block
         | sequence_block

// Replaces GPP #include. The path is a string literal. Resolving and inlining
// comes later.
//
include_directive: "include"i ESCAPED_STRING _opt_semi

// Replaces WDL1 `param NAME=INT` (case-insensitive, per wdlParser.consume).
// Float values are accepted unconditionally (resolves issue #33).
//
param_decl: "param"i CNAME "=" expr _SEMI

// Replaces WDL1 `const NAME=INT`.
//
const_decl: "const"i CNAME "=" expr _SEMI

// ----------------------------------------------------------------------------
// signals { ... } block
// ----------------------------------------------------------------------------
// Replaces the .signals file and GPP #define-based signal table. slot:chan is
// a distinct typed literal (not a numeric expression). Group aliases use the
// bracket form `Foo = [A, B, C];`. Conditional signal sets use top-level `if`.
//
signals_block: "signals"i "{" signal_item* "}"

signal_item: CNAME "=" signal_value _SEMI

?signal_value: slot_chan
             | signal_group
             | signal_ref

signal_group: "[" signal_value ("," signal_value)* "]"

signal_ref: CNAME

slot_chan: INT ":" INT

// ----------------------------------------------------------------------------
// slot { ... } block
// ----------------------------------------------------------------------------
// Replaces the WDL1 .mod SLOT blocks. The directive form is generic. the 17
// module types are validated downstream by the Archon target, not enumerated
// here.
//
slot_block: "slot"i INT CNAME "{" slot_dir* "}"

?slot_dir: slot_dir_array | slot_dir_kv

// `LVLC 1 [V_BiasGate, 2] "Bias Gate";`. Channel + bracket args + label
//
slot_dir_array: CNAME slot_dir_chan? slot_dir_args? ESCAPED_STRING? _opt_semi

// `DIOPOWER = 0;`. Key=value form, with optional channel (`CLAMP 1 = 1.5;`)
//
slot_dir_kv: CNAME slot_dir_chan? "=" expr _opt_semi

slot_dir_chan: INT

slot_dir_args: "[" arg_list "]"

// ----------------------------------------------------------------------------
// waveform { ... } block
// ----------------------------------------------------------------------------
// Replaces the WDL1 .waveform files. RETURN is not permitted in native. the
// closing brace ends a waveform, and the compiler emits the ACF-format RETURN
// as a codegen concern.
//
waveform_block: "waveform"i CNAME "{" wf_stmt* "}"

// A time-prefixed SET with an optional =label, or a bare SET. one SET per
// statement. lines that share a time are written as bare SETs that inherit the
// previous time.
//
?wf_stmt: wf_timed_set | wf_bare_set

wf_timed_set: time_designator ":" wf_label? set_stmt

wf_bare_set: set_stmt

wf_label: "=" CNAME

?time_designator: time_relative | time_absolute

// `.+expr` adds to the previous evaluated time.
//
time_relative: "." "+" expr

time_absolute: expr

// SET statement. the target is a single signal / slot:chan or a bracketed list.
// FAST/SLOW slew is accepted here. enforcement is left to a semantic phase.
//
set_stmt: "set"i set_target_or_group "to"i expr slew? _SEMI

?set_target_or_group: set_target | set_target_group

set_target_group: "[" set_target ("," set_target)* "]"

?set_target: set_target_slotchan | set_target_ref

set_target_slotchan: slot_chan

set_target_ref: CNAME

slew: "," SLEW_KIND

SLEW_KIND: "FAST"i | "SLOW"i

// ----------------------------------------------------------------------------
// sequence { ... } block
// ----------------------------------------------------------------------------
// Replaces the WDL1 .seq SEQUENCE blocks. CALL is optional (a bare name is an
// implicit call). IF supports `!` negation across param and const (issue #30).
//
sequence_block: "sequence"i CNAME "{" seq_stmt* "}"

?seq_stmt: explicit_call_stmt
        | ident_seq_stmt
        | goto_stmt
        | if_stmt
        | return_stmt

// `CALL Name(arg);`
//
explicit_call_stmt: "call"i CNAME "(" arg? ")" _SEMI

// `Name(arg);`, or `param++;` / `param--;`
//
ident_seq_stmt: CNAME ident_seq_tail

?ident_seq_tail: ident_seq_call | ident_seq_inc | ident_seq_dec

ident_seq_call: "(" arg? ")" _SEMI

ident_seq_inc: "++" _SEMI

ident_seq_dec: "--" _SEMI

goto_stmt: "goto"i CNAME "(" ")" _SEMI

// `if !param body`. the `!` negation resolves issue #30 across param and const.
//
if_stmt: "if"i if_neg? CNAME seq_stmt

if_neg: "!"

// `return;`. the alternate-name form is not permitted in native (DECISIONS.md).
//
return_stmt: "return"i _SEMI

// ----------------------------------------------------------------------------
// expressions
// ----------------------------------------------------------------------------
// Replaces GPP #eval. Integer and float arithmetic are first-class. floats are
// supported unconditionally (no integer-only restriction).
//
?expr: sum
?sum: product
    | sum "+" product -> add
    | sum "-" product -> sub
?product: unary
        | product "*" unary -> mul
        | product "/" unary -> div
        | product "%" unary -> mod
?unary: atom
      | "-" unary -> neg
      | "+" unary -> pos
?atom: INT          -> int_atom
     | FLOAT        -> float_atom
     | CNAME        -> ident_atom
     | "(" expr ")"

// argument list, used by slot directive bracket args
//
arg_list: expr ("," expr)*

// single argument, used by sequence CALL and implicit-call statements
//
arg: expr

// ----------------------------------------------------------------------------
// lexical
// ----------------------------------------------------------------------------
//
_SEMI: ";"

// Used where WDL1 leniency allowed an optional terminator (e.g. include);
// native is strict for statements, lenient for block-closing directives.
//
_opt_semi: ";"?

INT: /\d+/
FLOAT: /\d+\.\d*([eE][+-]?\d+)?|\.\d+([eE][+-]?\d+)?|\d+[eE][+-]?\d+/

%import common.CNAME
%import common.ESCAPED_STRING
%import common.WS
%ignore WS

// Comment forms inherited from WDL1.
//
LINE_COMMENT: /\/\/[^\n]*/
BLOCK_COMMENT: /\/\*([^*]|\*+[^*\/])*\*+\//
%ignore LINE_COMMENT
%ignore BLOCK_COMMENT
